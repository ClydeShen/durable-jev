    {
      "ruleId": "R32",
      "version": "1",
      "title": "Within credit",
      "owner": "commercial-control",
      "scope": "order",
      "dependsOn": [],
      "evaluator": {
        "kind": "expression",
        "ref": "R32"
      },
      "unknownPolicy": "block",
