      "parameters": ["creditExceptionLimitCents"],
      "invalidationTriggers": ["quote"],
      "appliesWhen": {
        "op": "not",
        "of": {
          "op": "ref",
          "ruleId": "R32"
        }
      },
      "expression": {
        "passWhen": "order.quote.amountCents + order.quote.extraCostCents - (order.customer.creditLimitCents - order.customer.outstandingCents) <= params.creditExceptionLimitCents",
        "observe": "order.quote.amountCents + order.quote.extraCostCents - (order.customer.creditLimitCents - order.customer.outstandingCents)"
      }
