      "version": "1",
      "scope": "cargoItem",
      "dependsOn": ["R01"],
      "evaluator": {
        "kind": "code",
        "ref": "weightAndDimensionsValid"
      },
      "unknownPolicy": "block",
      "inputPaths": [
        "cargoItems.weightGrams",
        "cargoItems.lengthMm",
        "cargoItems.widthMm",
        "cargoItems.heightMm"
      ],
      "parameters": ["maxCargoItemWeightGrams", "maxCargoItemDimensionMm"],
      "invalidationTriggers": ["cargo"]
    },
