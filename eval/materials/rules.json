  "rules": [
    {
      "ruleId": "R01",
      "version": "1",
      "scope": "order",
      "dependsOn": [],
      "evaluator": {
        "kind": "code",
        "ref": "requiredFieldsPresent"
      },
      "unknownPolicy": "block",
      "inputPaths": [
        "shipmentId",
        "customerId",
        "origin",
        "destination",
        "deliveryWindow",
        "cargoItems",
        "legs",
        "quote"
      ],
      "parameters": [],
      "invalidationTriggers": ["cargo", "route", "quote"]
    },
    {
