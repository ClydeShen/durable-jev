{
  "ruleSetVersion": "policy-v1",
  "rules": [
    {
      "ruleId": "R01",
      "version": "1",
      "title": "Order complete",
      "owner": "order-coordination",
      "scope": "order",
      "dependsOn": [],
      "evaluator": {
        "kind": "expression",
        "ref": "R01"
      },
      "unknownPolicy": "block",
      "inputPaths": [],
      "parameters": [],
      "invalidationTriggers": ["cargo", "route", "quote"],
      "expression": {
        "passWhen": "order.customerId != null and order.deliveryWindow.from != null and order.deliveryWindow.to != null and count(cargoItems) > 0 and count(legs) > 0"
      }
    },
    {
      "ruleId": "R02",
      "version": "1",
      "title": "Measurements valid",
      "owner": "order-coordination",
      "scope": "cargoItem",
      "dependsOn": ["R01"],
      "evaluator": {
        "kind": "expression",
        "ref": "R02"
      },
      "unknownPolicy": "block",
      "inputPaths": [],
      "parameters": [],
      "invalidationTriggers": ["cargo"],
      "expression": {
        "passWhen": "item.weightGrams > 0 and item.quantity > 0 and item.volumeCubicCm > 0 and item.dimensionsMillimetres.length > 0 and item.dimensionsMillimetres.width > 0 and item.dimensionsMillimetres.height > 0",
        "observe": "item.weightGrams"
      }
    },
    {
      "ruleId": "R03",
      "version": "1",
      "title": "Description matches declaration",
      "owner": "cargo-assurance",
      "scope": "cargoItem",
      "dependsOn": ["R01"],
      "evaluator": {
        "kind": "semantic",
        "ref": "R03"
      },
      "unknownPolicy": "block",
      "inputPaths": [],
      "parameters": ["semanticMatchThreshold"],
      "invalidationTriggers": ["cargo", "documents"],
      "semantic": {
        "promptVersion": "r03-v1",
        "question": {
          "kind": "noul",
          "text": "The cargo description describes goods of the declared categories (general, coldChain, controlled)."
        },
        "state": {
          "description": "item.description",
          "declaredCategories": "item.declaredCategories"
        },
        "passWhen": {
          "probabilityAtLeast": "semanticMatchThreshold"
        }
      }
    },
    {
      "ruleId": "R04",
      "version": "1",
      "title": "Branch determined",
      "owner": "cargo-assurance",
      "scope": "cargoItem",
      "dependsOn": ["R02", "R03"],
      "evaluator": {
        "kind": "expression",
        "ref": "R04"
      },
      "unknownPolicy": "block",
      "inputPaths": [],
      "parameters": [],
      "invalidationTriggers": ["cargo"],
      "expression": {
        "passWhen": "count(item.declaredCategories) > 0",
        "observe": "item.declaredCategories"
      }
    },
    {
      "ruleId": "R05",
      "version": "1",
      "title": "Vehicle payload",
      "owner": "transport-planning",
      "scope": "leg",
      "dependsOn": ["R02"],
      "evaluator": {
        "kind": "expression",
        "ref": "R05"
      },
      "unknownPolicy": "block",
      "inputPaths": [],
      "parameters": [],
      "invalidationTriggers": ["cargo", "route"],
      "expression": {
        "passWhen": "sum(cargoItems.weightGrams) <= leg.vehicle.maxPayloadGrams",
        "observe": "sum(cargoItems.weightGrams)"
      }
    },
    {
      "ruleId": "R06",
      "version": "1",
      "title": "Delivery window",
      "owner": "transport-planning",
      "scope": "order",
      "dependsOn": [],
      "evaluator": {
        "kind": "expression",
        "ref": "R06"
      },
      "unknownPolicy": "block",
      "inputPaths": [],
      "parameters": [],
      "invalidationTriggers": ["route"],
      "expression": {
        "passWhen": "date and time(legs[-1].plannedArrival) >= date and time(order.deliveryWindow.from) and date and time(legs[-1].plannedArrival) <= date and time(order.deliveryWindow.to)",
        "observe": "legs[-1].plannedArrival"
      }
    },
    {
      "ruleId": "R07",
      "version": "1",
      "title": "Leg sequence",
      "owner": "transport-planning",
      "scope": "leg",
      "dependsOn": [],
      "evaluator": {
        "kind": "expression",
        "ref": "R07"
      },
      "unknownPolicy": "block",
      "inputPaths": [],
      "parameters": ["minLegConnectionMinutes"],
      "invalidationTriggers": ["route"],
      "expression": {
        "passWhen": "date and time(leg.plannedDeparture) < date and time(leg.plannedArrival) and (leg.sequence = 1 or date and time(leg.plannedDeparture) - date and time(legs[leg.sequence - 1].plannedArrival) >= duration(\"PT\" + string(params.minLegConnectionMinutes) + \"M\"))"
      }
    },
    {
      "ruleId": "R08",
      "version": "1",
      "title": "No conflicting identities",
      "owner": "order-coordination",
      "scope": "order",
      "dependsOn": ["R01"],
      "evaluator": {
        "kind": "expression",
        "ref": "R08"
      },
      "unknownPolicy": "block",
      "inputPaths": [],
      "parameters": [],
      "invalidationTriggers": ["cargo"],
      "expression": {
        "passWhen": "every i in cargoItems satisfies i.shipmentId = order.shipmentId"
      }
    },
    {
      "ruleId": "R09",
      "version": "1",
      "title": "Controlled documents present",
      "owner": "cargo-assurance",
      "scope": "cargoItem",
      "dependsOn": ["R04"],
      "evaluator": {
        "kind": "expression",
        "ref": "R09"
      },
      "unknownPolicy": "block",
      "inputPaths": [],
      "parameters": [],
      "invalidationTriggers": ["cargo", "documents"],
      "appliesWhen": {
        "op": "observed",
        "ruleId": "R04",
        "includes": "controlled"
      },
      "expression": {
        "passWhen": "list contains(item.documentKinds, \"safetyDataSheet\") and list contains(item.documentKinds, \"controlledDeclaration\")",
        "observe": "item.documentKinds"
      }
    },
    {
      "ruleId": "R10",
      "version": "1",
      "title": "Documents match the goods",
      "owner": "cargo-assurance",
      "scope": "cargoItem",
      "dependsOn": ["R04", "R09"],
      "evaluator": {
        "kind": "semantic",
        "ref": "R10"
      },
      "unknownPolicy": "block",
      "inputPaths": [],
      "parameters": ["semanticMatchThreshold"],
      "invalidationTriggers": ["cargo", "documents"],
      "appliesWhen": {
        "op": "observed",
        "ruleId": "R04",
        "includes": "controlled"
      },
      "semantic": {
        "promptVersion": "r10-v1",
        "question": {
          "kind": "noul",
          "text": "The safety data sheet describes the same goods as the cargo description."
        },
        "state": {
          "description": "item.description",
          "safetyDataSheet": "item.documentTexts.safetyDataSheet"
        },
        "passWhen": {
          "probabilityAtLeast": "semanticMatchThreshold"
        }
      }
    },
    {
      "ruleId": "R11",
      "version": "1",
      "title": "Carrier qualified",
      "owner": "cargo-assurance",
      "scope": "leg",
      "dependsOn": ["R04", "R09"],
      "evaluator": {
        "kind": "expression",
        "ref": "R11"
      },
      "unknownPolicy": "block",
      "inputPaths": [],
      "parameters": [],
      "invalidationTriggers": ["carrier", "route"],
      "appliesWhen": {
        "op": "anyOf",
        "scope": "cargoItem",
        "of": {
          "op": "observed",
          "ruleId": "R04",
          "includes": "controlled"
        }
      },
      "expression": {
        "passWhen": "list contains(leg.carrier.qualifications, \"CTRL\") and date and time(leg.carrier.qualificationsValidUntil) >= date and time(leg.plannedDeparture)",
        "observe": "leg.carrier.qualifications"
      }
    },
    {
      "ruleId": "R12",
      "version": "1",
      "title": "Mixing allowed",
      "owner": "cargo-assurance",
      "scope": "order",
      "dependsOn": ["R04"],
      "evaluator": {
        "kind": "decisionTable",
        "ref": "R12"
      },
      "unknownPolicy": "block",
      "inputPaths": [],
      "parameters": [],
      "invalidationTriggers": ["cargo", "carrier", "route"],
      "mixing": {
        "categories": "flatten(cargoItems.declaredCategories)",
        "qualifications": "if every l in legs satisfies list contains(l.carrier.qualifications, \"CTRL-COLD\") then [\"CTRL-COLD\"] else []"
      }
    },
    {
      "ruleId": "R13",
      "version": "1",
      "title": "Compliance sign-off",
      "owner": "cargo-assurance",
      "scope": "cargoItem",
      "dependsOn": ["R04", "R10", "R11", "R12"],
      "evaluator": {
        "kind": "humanGate",
        "ref": "R13"
      },
      "unknownPolicy": "block",
      "inputPaths": [],
      "parameters": [],
      "invalidationTriggers": ["cargo", "carrier", "route", "documents"],
      "appliesWhen": {
        "op": "observed",
        "ruleId": "R04",
        "includes": "controlled"
      },
      "humanGate": {
        "taskType": "APPROVAL",
        "steps": [
          {
            "requiredRole": "complianceReviewer"
          },
          {
            "requiredRole": "qualityReviewer",
            "appliesWhen": {
              "op": "observed",
              "ruleId": "R04",
              "includes": "coldChain"
            }
          }
        ],
        "mode": "sequential",
        "distinctActors": true,
        "evidenceRequirements": [],
        "expiresAfterHours": 24
      }
    },
    {
      "ruleId": "R14",
      "version": "1",
      "title": "Controlled branch ready",
      "owner": "cargo-assurance",
      "scope": "cargoItem",
      "dependsOn": ["R04", "R09", "R10", "R11", "R13"],
      "evaluator": {
        "kind": "combinator",
        "ref": "R14"
      },
      "unknownPolicy": "block",
      "inputPaths": [],
      "parameters": [],
      "invalidationTriggers": [],
      "appliesWhen": {
        "op": "observed",
        "ruleId": "R04",
        "includes": "controlled"
      },
      "combiner": {
        "op": "and",
        "of": [
          {
            "op": "ref",
            "ruleId": "R09"
          },
          {
            "op": "ref",
            "ruleId": "R10"
          },
          {
            "op": "allOf",
            "scope": "leg",
            "of": {
              "op": "ref",
              "ruleId": "R11"
            }
          },
          {
            "op": "ref",
            "ruleId": "R13"
          }
        ]
      }
    },
    {
      "ruleId": "R15",
      "version": "1",
      "title": "Target range set",
      "owner": "cargo-assurance",
      "scope": "cargoItem",
      "dependsOn": ["R04"],
      "evaluator": {
        "kind": "expression",
        "ref": "R15"
      },
      "unknownPolicy": "block",
      "inputPaths": [],
      "parameters": [],
      "invalidationTriggers": ["cargo"],
      "appliesWhen": {
        "op": "observed",
        "ruleId": "R04",
        "includes": "coldChain"
      },
      "expression": {
        "passWhen": "item.temperatureRange != null and item.temperatureRange.minDeciCelsius <= item.temperatureRange.maxDeciCelsius",
        "observe": "item.temperatureRange"
      }
    },
    {
      "ruleId": "R16",
      "version": "1",
      "title": "Vehicle temperature capability",
      "owner": "transport-planning",
      "scope": "leg",
      "dependsOn": ["R04", "R15"],
      "evaluator": {
        "kind": "expression",
        "ref": "R16"
      },
      "unknownPolicy": "block",
      "inputPaths": [],
      "parameters": [],
      "invalidationTriggers": ["cargo", "route"],
      "appliesWhen": {
        "op": "anyOf",
        "scope": "cargoItem",
        "of": {
          "op": "observed",
          "ruleId": "R04",
          "includes": "coldChain"
        }
      },
      "expression": {
        "passWhen": "every i in cargoItems satisfies (not(list contains(i.declaredCategories, \"coldChain\")) or (leg.vehicle.temperatureControlled and leg.vehicle.minDeciCelsius <= i.temperatureRange.minDeciCelsius and leg.vehicle.maxDeciCelsius >= i.temperatureRange.maxDeciCelsius))"
      }
    },
    {
      "ruleId": "R17",
      "version": "1",
      "title": "Sensor valid",
      "owner": "cargo-assurance",
      "scope": "cargoItem",
      "dependsOn": ["R04", "R15"],
      "evaluator": {
        "kind": "expression",
        "ref": "R17"
      },
      "unknownPolicy": "block",
      "inputPaths": [],
      "parameters": ["sensorRecordMaxAgeHours"],
      "invalidationTriggers": ["cargo", "route", "documents"],
      "appliesWhen": {
        "op": "observed",
        "ruleId": "R04",
        "includes": "coldChain"
      },
      "expression": {
        "passWhen": "item.sensor.calibrated and date and time(item.sensor.lastRecordAt) >= date and time(legs[1].plannedDeparture) - duration(\"PT\" + string(params.sensorRecordMaxAgeHours) + \"H\")",
        "observe": "item.sensor.lastRecordAt"
      }
    },
    {
      "ruleId": "R18",
      "version": "1",
      "title": "Inspection risk signal",
      "owner": "cargo-assurance",
      "scope": "cargoItem",
      "dependsOn": ["R04"],
      "evaluator": {
        "kind": "semantic",
        "ref": "R18"
      },
      "unknownPolicy": "block",
      "inputPaths": [],
      "parameters": [],
      "invalidationTriggers": ["cargo", "documents"],
      "appliesWhen": {
        "op": "observed",
        "ruleId": "R04",
        "includes": "coldChain"
      },
      "semantic": {
        "promptVersion": "r18-v1",
        "question": {
          "kind": "choice",
          "text": "Which risk signal does the warehouse inspection note show?",
          "options": {
            "no_risk": "No packaging damage or temperature risk is described",
            "damaged_packaging": "Physical damage to the packaging is described",
            "cold_chain_risk": "Temperature control appears compromised without physical damage"
          }
        },
        "state": {
          "inspectionNote": "item.inspectionNote"
        },
        "passWhen": {
          "choiceIn": ["no_risk"]
        }
      }
    },
    {
      "ruleId": "R19",
      "version": "1",
      "title": "Excursion within tolerance",
      "owner": "cargo-assurance",
      "scope": "cargoItem",
      "dependsOn": ["R04", "R15", "R17"],
      "evaluator": {
        "kind": "expression",
        "ref": "R19"
      },
      "unknownPolicy": "block",
      "inputPaths": [],
      "parameters": ["excursionToleranceMinutes"],
      "invalidationTriggers": ["cargo", "documents"],
      "appliesWhen": {
        "op": "observed",
        "ruleId": "R04",
        "includes": "coldChain"
      },
      "expression": {
        "passWhen": "item.temperatureLog.longestExcursionMinutes <= params.excursionToleranceMinutes",
        "observe": "item.temperatureLog.longestExcursionMinutes"
      }
    },
    {
      "ruleId": "R20",
      "version": "1",
      "title": "Quality disposition",
      "owner": "cargo-assurance",
      "scope": "cargoItem",
      "dependsOn": ["R04", "R19"],
      "evaluator": {
        "kind": "humanGate",
        "ref": "R20"
      },
      "unknownPolicy": "block",
      "inputPaths": [],
      "parameters": [],
      "invalidationTriggers": ["cargo", "documents"],
      "appliesWhen": {
        "op": "not",
        "of": {
          "op": "ref",
          "ruleId": "R19"
        }
      },
      "humanGate": {
        "taskType": "APPROVAL",
        "steps": [
          {
            "requiredRole": "qualityReviewer"
          },
          {
            "requiredRole": "complianceReviewer",
            "appliesWhen": {
              "op": "observed",
              "ruleId": "R04",
              "includes": "controlled"
            }
          }
        ],
        "mode": "sequential",
        "distinctActors": true,
        "evidenceRequirements": [],
        "expiresAfterHours": 24
      }
    },
    {
      "ruleId": "R21",
      "version": "1",
      "title": "Repacked",
      "owner": "cargo-assurance",
      "scope": "cargoItem",
      "dependsOn": ["R18"],
      "evaluator": {
        "kind": "humanGate",
        "ref": "R21"
      },
      "unknownPolicy": "block",
      "inputPaths": [],
      "parameters": [],
      "invalidationTriggers": ["cargo", "documents"],
      "appliesWhen": {
        "op": "not",
        "of": {
          "op": "ref",
          "ruleId": "R18"
        }
      },
      "humanGate": {
        "taskType": "OPERATION",
        "steps": [
          {
            "requiredRole": "warehouseOperator"
          }
        ],
        "mode": "sequential",
        "distinctActors": true,
        "evidenceRequirements": ["newPackagingId", "photoRef"],
        "expiresAfterHours": 12
      }
    },
    {
      "ruleId": "R22",
      "version": "1",
      "title": "Retest passed",
      "owner": "cargo-assurance",
      "scope": "cargoItem",
      "dependsOn": ["R18", "R21"],
      "evaluator": {
        "kind": "humanGate",
        "ref": "R22"
      },
      "unknownPolicy": "block",
      "inputPaths": [],
      "parameters": [],
      "invalidationTriggers": ["cargo", "documents"],
      "appliesWhen": {
        "op": "not",
        "of": {
          "op": "ref",
          "ruleId": "R18"
        }
      },
      "humanGate": {
        "taskType": "OPERATION",
        "steps": [
          {
            "requiredRole": "warehouseOperator"
          }
        ],
        "mode": "sequential",
        "distinctActors": true,
        "evidenceRequirements": ["retestDeciCelsius", "photoRef"],
        "expiresAfterHours": 12
      }
    },
    {
      "ruleId": "R23",
      "version": "1",
      "title": "Cold chain branch ready",
      "owner": "cargo-assurance",
      "scope": "cargoItem",
      "dependsOn": ["R04", "R15", "R16", "R17", "R18", "R19", "R20", "R21", "R22"],
      "evaluator": {
        "kind": "combinator",
        "ref": "R23"
      },
      "unknownPolicy": "block",
      "inputPaths": [],
      "parameters": [],
      "invalidationTriggers": [],
      "appliesWhen": {
        "op": "observed",
        "ruleId": "R04",
        "includes": "coldChain"
      },
      "combiner": {
        "op": "and",
        "of": [
          {
            "op": "ref",
            "ruleId": "R15"
          },
          {
            "op": "allOf",
            "scope": "leg",
            "of": {
              "op": "ref",
              "ruleId": "R16"
            }
          },
          {
            "op": "ref",
            "ruleId": "R17"
          },
          {
            "op": "or",
            "of": [
              {
                "op": "ref",
                "ruleId": "R19"
              },
              {
                "op": "ref",
                "ruleId": "R20"
              }
            ]
          },
          {
            "op": "ifThen",
            "condition": {
              "op": "not",
              "of": {
                "op": "ref",
                "ruleId": "R18"
              }
            },
            "consequence": {
              "op": "and",
              "of": [
                {
                  "op": "ref",
                  "ruleId": "R21"
                },
                {
                  "op": "ref",
                  "ruleId": "R22"
                }
              ]
            }
          }
        ]
      }
    },
    {
      "ruleId": "R24",
      "version": "1",
      "title": "Service region",
      "owner": "transport-planning",
      "scope": "leg",
      "dependsOn": [],
      "evaluator": {
        "kind": "expression",
        "ref": "R24"
      },
      "unknownPolicy": "block",
      "inputPaths": [],
      "parameters": [],
      "invalidationTriggers": ["route", "carrier"],
      "expression": {
        "passWhen": "list contains(leg.carrier.serviceRegions, leg.originRegion) and list contains(leg.carrier.serviceRegions, leg.destinationRegion)"
      }
    },
    {
      "ruleId": "R25",
      "version": "1",
      "title": "Vehicle volume",
      "owner": "transport-planning",
      "scope": "leg",
      "dependsOn": ["R05"],
      "evaluator": {
        "kind": "expression",
        "ref": "R25"
      },
      "unknownPolicy": "block",
      "inputPaths": [],
      "parameters": [],
      "invalidationTriggers": ["cargo", "route"],
      "expression": {
        "passWhen": "sum(cargoItems.volumeCubicCm) <= leg.vehicle.maxVolumeCubicCm",
        "observe": "sum(cargoItems.volumeCubicCm)"
      }
    },
    {
      "ruleId": "R26",
      "version": "1",
      "title": "Transfer hub capability",
      "owner": "transport-planning",
      "scope": "leg",
      "dependsOn": [],
      "evaluator": {
        "kind": "expression",
        "ref": "R26"
      },
      "unknownPolicy": "block",
      "inputPaths": [],
      "parameters": [],
      "invalidationTriggers": ["cargo", "route"],
      "expression": {
        "passWhen": "leg.transferHub = null or ((not(list contains(flatten(cargoItems.declaredCategories), \"coldChain\")) or leg.transferHub.coldStorage) and (not(list contains(flatten(cargoItems.declaredCategories), \"controlled\")) or leg.transferHub.securedCage))",
        "observe": "leg.transferHub.hubId"
      }
    },
    {
      "ruleId": "R27",
      "version": "1",
      "title": "Customer restrictions",
      "owner": "commercial-control",
      "scope": "order",
      "dependsOn": [],
      "evaluator": {
        "kind": "semantic",
        "ref": "R27"
      },
      "unknownPolicy": "block",
      "inputPaths": [],
      "parameters": ["semanticMatchThreshold"],
      "invalidationTriggers": ["route", "quote"],
      "semantic": {
        "promptVersion": "r27-v1",
        "question": {
          "kind": "noul",
          "text": "The customer's written restrictions allow the planned route and handover. With no written restrictions, they allow it."
        },
        "state": {
          "restrictions": "order.customer.restrictionsText",
          "route": "for l in legs return l.origin + \" -> \" + l.destination",
          "handover": "order.handover"
        },
        "passWhen": {
          "probabilityAtLeast": "semanticMatchThreshold"
        }
      }
    },
    {
      "ruleId": "R29",
      "version": "1",
      "title": "Transport reserved",
      "owner": "transport-planning",
      "scope": "leg",
      "dependsOn": ["R05", "R06", "R07", "R24", "R25", "R26"],
      "evaluator": {
        "kind": "code",
        "ref": "R29"
      },
      "unknownPolicy": "block",
      "inputPaths": [],
      "parameters": [],
      "invalidationTriggers": ["route", "carrier"]
    },
    {
      "ruleId": "R30",
      "version": "1",
      "title": "Plan valid",
      "owner": "transport-planning",
      "scope": "order",
      "dependsOn": ["R05", "R06", "R07", "R24", "R25", "R26", "R29"],
      "evaluator": {
        "kind": "combinator",
        "ref": "R30"
      },
      "unknownPolicy": "block",
      "inputPaths": [],
      "parameters": [],
      "invalidationTriggers": [],
      "combiner": {
        "op": "and",
        "of": [
          {
            "op": "ref",
            "ruleId": "R06"
          },
          {
            "op": "allOf",
            "scope": "leg",
            "of": {
              "op": "and",
              "of": [
