          "title": "Oakline Furniture: handover",
          "owner": "commercial-control",
          "scope": "order",
          "applicability": {
            "customers": ["CUS-OAK"]
          },
          "dependsOn": [],
          "evaluator": {
            "kind": "expression",
            "ref": "CUST-OAK-1"
          },
          "unknownPolicy": "block",
          "inputPaths": [],
          "parameters": [],
          "invalidationTriggers": ["route"],
          "expression": {
            "passWhen": "list contains([\"curbside\", \"customerSite\"], order.handover)",
            "observe": "order.handover"
          }
        },
        {
          "ruleId": "CUST-OAK-2",
          "version": "1",
          "title": "Oakline Furniture: arrival margin",
          "owner": "commercial-control",
          "scope": "order",
          "applicability": {
            "customers": ["CUS-OAK"]
          },
          "dependsOn": [],
          "evaluator": {
            "kind": "expression",
            "ref": "CUST-OAK-2"
          },
          "unknownPolicy": "block",
          "inputPaths": [],
          "parameters": [],
          "invalidationTriggers": ["route"],
          "expression": {
            "passWhen": "date and time(legs[-1].plannedArrival) + duration(\"PT0M\") <= date and time(order.deliveryWindow.to)",
            "observe": "legs[-1].plannedArrival"
          }
        },
        {
          "ruleId": "CUST-OAK-3",
          "version": "1",
          "title": "Oakline Furniture: extra cost cap",
          "owner": "commercial-control",
          "scope": "order",
          "applicability": {
            "customers": ["CUS-OAK"]
          },
          "dependsOn": [],
          "evaluator": {
            "kind": "expression",
            "ref": "CUST-OAK-3"
          },
          "unknownPolicy": "block",
          "inputPaths": [],
          "parameters": [],
          "invalidationTriggers": ["quote"],
          "expression": {
            "passWhen": "order.quote.extraCostCents <= 25000",
            "observe": "order.quote.extraCostCents"
          }
        },
        {
          "ruleId": "CUST-OAK-4",
          "version": "1",
          "title": "Oakline Furniture: invoice currency",
          "owner": "commercial-control",
          "scope": "order",
          "applicability": {
            "customers": ["CUS-OAK"]
          },
          "dependsOn": [],
          "evaluator": {
            "kind": "expression",
            "ref": "CUST-OAK-4"
          },
          "unknownPolicy": "block",
          "inputPaths": [],
          "parameters": [],
          "invalidationTriggers": ["quote"],
          "expression": {
            "passWhen": "order.quote.currency = \"EUR\"",
            "observe": "order.quote.currency"
          }
        },
