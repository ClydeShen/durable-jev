        },
        "attributes": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "parentSpanId": {
          "type": "string",
          "pattern": "^[0-9a-f]{16}$"
        },
        "startedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "links": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "traceId": {
                "type": "string",
                "pattern": "^[0-9a-f]{32}$"
              },
              "spanId": {
                "type": "string",
                "pattern": "^[0-9a-f]{16}$"
              },
              "relation": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "traceId",
              "spanId",
              "relation"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "kind",
        "eventName",
        "eventId",
        "timestamp",
        "severity",
        "service",
        "correlationId",
        "caseId",
        "traceId",
        "spanId",
        "startedAt"
      ],
      "additionalProperties": false
    }
  ]
}
