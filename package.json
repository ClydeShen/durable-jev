{
  "name": "durable-jev",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "bootstrap": "pnpm install && pnpm build",
    "build": "tsc -b && pnpm --filter @durable-jev/web build",
    "clean": "tsc -b --clean",
    "test": "vitest run",
    "lint": "biome check .",
    "start": "pnpm build && node --env-file-if-exists=.env tools/launcher/dist/main.js",
    "format": "biome format --write .",
    "spikes": "pnpm --filter @durable-jev/spike-pi-durable crash-recovery && pnpm --filter @durable-jev/spike-pi-durable module-flow && pnpm --filter @durable-jev/spike-a2a round-trip && pnpm --filter @durable-jev/spike-jev semantic-checks && pnpm --filter @durable-jev/spike-trace propagation",
    "models:live-check": "pnpm --filter @durable-jev/model-providers live-check",
    "typecheck": "tsc -b && tsc -p tsconfig.typecheck.json",
    "knip": "knip",
    "demo:reset": "node tools/launcher/dist/demo-reset.js",
    "replay": "node eval/runner/dist/main.js"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "22.20.5",
    "knip": "6.42.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
