{
  "name": "durable-jev",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "bootstrap": "pnpm install && pnpm build",
    "build": "tsc -b && pnpm --filter @durable-jev/web typecheck",
    "clean": "tsc -b --clean",
    "test": "vitest run",
    "lint": "biome check . && node tools/check-conventions/check.mjs",
    "check:conventions": "node tools/check-conventions/check.mjs",
    "start": "tsc -b && node tools/launcher/dist/main.js",
    "demo": "pnpm install && pnpm build && node tools/launcher/dist/main.js --open",
    "format": "biome format --write .",
    "spikes": "pnpm --filter @durable-jev/spike-pi-durable crash-recovery && pnpm --filter @durable-jev/spike-a2a round-trip && pnpm --filter @durable-jev/spike-jev semantic-checks && pnpm --filter @durable-jev/spike-trace propagation",
    "demo:reset": "node tools/launcher/dist/demo-reset-cli.js",
    "replay": "pnpm --filter @durable-jev/eval-runner replay",
    "faults": "pnpm --filter @durable-jev/eval-faults faults"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
