{
  "name": "durable-jev",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": "^26.12.0"
  },
  "scripts": {
    "prepare": "lefthook install",
    "bootstrap": "pnpm install && pnpm build",
    "build": "tsc -b && pnpm --filter @durable-jev/web build",
    "clean": "tsc -b --clean",
    "test": "vitest run",
    "lint": "biome check --error-on-warnings .",
    "start": "pnpm build && node --env-file-if-exists=.env tools/launcher/dist/main.js",
    "start:a2a": "pnpm build && AGENT_TRANSPORT=a2a node --env-file-if-exists=.env tools/launcher/dist/main.js",
    "format": "biome format --write .",
    "spikes": "pnpm --filter @durable-jev/spike-pi-durable crash-recovery && pnpm --filter @durable-jev/spike-pi-durable module-flow && pnpm --filter @durable-jev/spike-a2a round-trip && pnpm --filter @durable-jev/spike-jev semantic-checks && pnpm --filter @durable-jev/spike-trace propagation",
    "models:live-check": "pnpm --filter @durable-jev/model-providers live-check",
    "typecheck": "tsc -b && tsc -p tsconfig.typecheck.json && tsc -p apps/web/tsconfig.json",
    "knip": "knip",
    "architecture": "node scripts/architecture-graph.mjs",
    "boundaries": "depcruise packages/*/src apps/*/src tools/*/src eval/runner/src --config .dependency-cruiser.cjs",
    "duplication": "jscpd --config .jscpd.json",
    "workspace-lint": "sherif",
    "security": "pnpm audit --audit-level moderate",
    "demo:reset": "node tools/launcher/dist/demo-reset.js",
    "replay": "node eval/runner/dist/replay-main.js",
    "screening": "node eval/runner/dist/screening-main.js",
    "faults": "node eval/runner/dist/faults-main.js",
    "check": "pnpm lint && pnpm workspace-lint && pnpm typecheck && pnpm boundaries && node scripts/architecture-graph.mjs --check && node scripts/materials-lock.mjs --check && pnpm knip && pnpm duplication && pnpm test",
    "author": "node tools/rule-authoring/dist/main.js",
    "materials:lock": "node scripts/materials-lock.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@types/node": "26.6.5",
    "dependency-cruiser": "18.7.0",
    "jscpd": "5.4.2",
    "knip": "6.42.1",
    "lefthook": "2.2.2",
    "sherif": "1.13.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
